{
  "name": "aurelia-syncfusion-ej-2-bridge",
  "type": "project:plugin",
  "paths": {
    "root": "dev-app",
    "resources": "../src",
    "elements": "../src/elements",
    "widgets": "../src/widgets",
    "utilities": "../src/utilities",
    "common": "../src/common",
    "attributes": "../src/attributes",
    "valueConverters": "../src/value-converters",
    "bindingBehaviors": "../src/binding-behaviors"
  },
  "transpiler": {
    "id": "typescript",
    "fileExtension": ".ts",
    "dtsSource": [
      "./types/**/*.d.ts"
    ],
    "source": [
      "dev-app/**/*.ts",
      "src/**/*.ts"
    ]
  },
  "plugin": {
    "source": {
      "js": "src/**/*.ts",
      "css": "src/**/*.css",
      "html": "src/**/*.html",
      "json": "src/**/*.json"
    }
  },
  "markupProcessor": {
    "source": [
      "dev-app/**/*.html",
      "src/**/*.html"
    ]
  },
  "cssProcessor": {
    "source": [
      "dev-app/**/*.css",
      "src/**/*.css"
    ]
  },
  "jsonProcessor": {
    "source": [
      "dev-app/**/*.json",
      "src/**/*.json"
    ]
  },
  "platform": {
    "port": 8090,
    "index": "index.html",
    "baseDir": ".",
    "output": "scripts"
  },
  "build": {
    "targets": [
      {
        "port": 8090,
        "index": "index.html",
        "baseDir": ".",
        "output": "scripts"
      }
    ],
    "options": {
      "minify": "stage & prod",
      "sourcemaps": "dev & stage",
      "rev": false,
      "cache": "dev & stage"
    },
